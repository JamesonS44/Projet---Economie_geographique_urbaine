  <node id="4879494380" lat="47.2272695" lon="-1.5531751">
    <tag k="artist_name" v="Jacques Raoult"/>
    <tag k="description" v="Plaque mémorielle situant l'emplacement, sur la rive gauche de l'Erdre, de l'extrémité de la Chaussée de Barbin"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="VOUS ETES ICI DANS L'UNE DES FOLIES DE BARBIN. | Ces embarcadères ont été édifiés sur chaque rive au débouché d'une ancienne chaussée | qui barrait l'Erdre en cet endroit. | Cette chaussée de Barbin fut creee, dit-on, par Saint-Felix, au VIème siècle[...]"/>
    <tag k="material" v="bronze"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Folie de Barbin"/>
    <tag k="start_date" v="1993"/>
    <tag k="wikidata" v="Q23041106"/>
  </node>
